wordy.cards, www.wordy.cards {
    # 1. Force HTTPS and use the Cloudflare Origin Certificates
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    # 2. Compression
    encode zstd gzip
    
    # 3. API Routing (Strips /api and sends to NestJS)
    handle_path /api/* {
        reverse_proxy server:3000
    }

    # 4. Frontend Routing
    handle {
        root * /srv
        try_files {path} /index.html
        file_server

        @static {
            path *.js *.css *.svg *.woff2 *.webp *.png *.ico
        }
        header @static Cache-Control "public, max-age=31536000, immutable"

        @html {
            path *.html
        }
        header @html Cache-Control "no-cache, no-store, must-revalidate"
    }
}